# Keep all secrets on the server. Never use a VITE_ prefix for API keys.
ADMIN_PASSWORD=replace-with-a-strong-password
DATABASE_PATH=.local/beescene.sqlite
API_PORT=5180
COOKIE_SECURE=false
# For HTTPS deployment set COOKIE_SECURE=true.
# Optional: enables generation only when both are configured.
OPENAI_API_KEY=
OPENAI_MODEL=
